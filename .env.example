# Copy this file to `.env` (in the project root) and fill in your keys.
#   cp .env.example .env
# Then run_all.sh / run_comparison.py / train_server.py read it automatically.

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Optional: needed only for gated HuggingFace models (e.g. Llama, some Gemma).
HF_TOKEN=hf_...
